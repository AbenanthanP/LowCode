 application "Cloud Infrastructure Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Cloud_Projects
		{
			displayname = "Cloud Projects"
			success message = "Cloud Project Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Project_Name
			(
    			type = text
				displayname = "Project Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Departments
			(
				type = picklist	
				values  = Departments.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Lead_Engineer_Name
			(
    			type = text
				displayname = "Lead Engineer Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			E_mail
			(
    			type = email
				displayname = "E-mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Cloud_Provider
			(
				type = picklist
				displayname = "Cloud Provider"
				maxchar = 100
				values = {"AWS","Microsoft Azure","Google Cloud"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Allocated_Project_Budget
			(
				type = decimal
				displayname = "Allocated Project Budget"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Project_Status
			(
				type = picklist
				displayname = "Project Status"
				maxchar = 100
				values = {"Active","Frozen / Overbudget"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Cloud_Resource_Registry
		{
			displayname = "Cloud Resource Registry"
			success message = "Cloud Resource Registry Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Resource_ID
			(
    			type = text
				displayname = "Resource ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cloud_Projects
			(
				type = picklist	
				displayname = "Cloud Projects"
				values  = Cloud_Projects.ID
    			displayformat = [Project_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resource_Type
			(
				type = picklist
				displayname = "Resource Type"
				maxchar = 100
				values = {"EC2 Compute Instance","S3 Storage Bucket","RDS Database","Kubernetes Cluster"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Instance_Size_Tier
			(
				type = picklist
				displayname = "Instance Size Tier"
				maxchar = 100
				values = {"t3.micro","t3.large","m5.2xlarge","db.r5.xlarge"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hourly_Cost
			(
				type = decimal
				displayname = "Hourly Cost"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Idle_CPU_Utilization
			(
				type = decimal
				displayname = "Idle CPU Utilization"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resource_Lifecycle_Status
			(
				type = picklist
				displayname = "Resource Lifecycle Status"
				maxchar = 100
				values = {"Running","Idle","Terminated"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Departments
		{
			success message = "Department Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Department_Name
			(
    			type = text
				displayname = "Department Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Head
			(
    			type = text
				displayname = "Department Head"
	 			row = 1
	 			column = 1   
				width = medium
			)
			E_mail
			(
    			type = email
				displayname = "E-mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Overall_Quarterly_Budget
			(
				type = decimal
				displayname = "Overall Quarterly Budget "
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Departments
		{
			displayName = "All Departments"
			show all rows from Departments    
			(
				Department_Name as "Department Name"
				Department_Head as "Department Head"
				E_mail as "E-mail"
				Overall_Quarterly_Budget as "Overall Quarterly Budget "
			)
		}
		default list All_Cloud_Projects
		{
			displayName = "All Cloud Projects"
			show all rows from Cloud_Projects    
			(
				Project_Name as "Project Name"
				Departments
				Lead_Engineer_Name as "Lead Engineer Name"
				E_mail as "E-mail"
				Cloud_Provider as "Cloud Provider"
				Allocated_Project_Budget as "Allocated Project Budget"
				Project_Status as "Project Status"
			)
		}
		default list All_Cloud_Resource_Registries
		{
			displayName = "All Cloud Resource Registries"
			show all rows from Cloud_Resource_Registry    
			(
				Resource_ID as "Resource ID"
				Cloud_Projects as "Cloud Projects"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier"
				Hourly_Cost as "Hourly Cost"
				Idle_CPU_Utilization as "Idle CPU Utilization"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
			)
		}
	}




	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

	customize
	{
		icon
		{
			text = "CIM"
			background color = "theme"
			foreground color = "#ffffff"
		}
	}

